{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:recruiting-agent:g1a:event:1.0.0",
  "title": "Recruiting Agent G1a event and operations contract",
  "description": "Stable, content-minimized domain-event envelope plus ActionExecution and ExceptionBundle records for the G1a control tower.",
  "oneOf": [
    { "$ref": "#/$defs/DomainEventEnvelope" },
    { "$ref": "#/$defs/ActionExecution" },
    { "$ref": "#/$defs/ExceptionBundle" }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ActorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id", "authority_snapshot_id"],
      "properties": {
        "actor_type": { "type": "string", "enum": ["HUMAN", "SYSTEM", "SERVICE"] },
        "actor_id": { "$ref": "#/$defs/Identifier" },
        "authority_snapshot_id": { "$ref": "#/$defs/Identifier" }
      }
    },
    "AggregateType": {
      "type": "string",
      "enum": [
        "APPLICATION_CASE",
        "INTERVIEW_ROUND",
        "INTERVIEW_SESSION",
        "EVALUATION_PACKAGE",
        "ACTION_EXECUTION",
        "EXCEPTION_BUNDLE",
        "PRIVACY_REQUEST"
      ]
    },
    "DataClassification": {
      "type": "string",
      "enum": ["INTERNAL", "RESTRICTED_PERSONAL", "SENSITIVE_PERSONAL"]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "InterviewSessionEnded",
        "CompletedInterviewImported",
        "RecordingAssetAvailable",
        "TranscriptReady",
        "TranscriptQualityRejected",
        "EvaluationDraftGenerated",
        "EvaluationValidationFailed",
        "EvaluationPackageReadyForReview",
        "EvaluationReviewSubmitted",
        "EvaluationConfirmed",
        "RoundDecisionRecorded",
        "InterviewRoundCompleted",
        "AutomationActionRequested",
        "AutomationActionSucceeded",
        "AutomationActionFailed",
        "AutomationActionCancelled",
        "ExternalActionSuppressed",
        "ExceptionBundleOpened",
        "ExceptionBundleResolved",
        "CasePaused",
        "CaseResumed",
        "ParticipantConsentWithdrawn",
        "DataDeletionRequested",
        "DataDeletionCompleted"
      ]
    },
    "DomainEventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "tenant_id",
        "aggregate_type",
        "aggregate_id",
        "aggregate_version",
        "application_case_id",
        "lifecycle_epoch",
        "occurred_at",
        "recorded_at",
        "actor_ref",
        "correlation_id",
        "causation_id",
        "trace_id",
        "data_classification",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "event_id": { "$ref": "#/$defs/Identifier" },
        "event_type": { "$ref": "#/$defs/EventType" },
        "tenant_id": { "$ref": "#/$defs/Identifier" },
        "aggregate_type": { "$ref": "#/$defs/AggregateType" },
        "aggregate_id": { "$ref": "#/$defs/Identifier" },
        "aggregate_version": { "type": "integer", "minimum": 1 },
        "application_case_id": { "$ref": "#/$defs/Identifier" },
        "lifecycle_epoch": { "type": "integer", "minimum": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "actor_ref": { "$ref": "#/$defs/ActorRef" },
        "correlation_id": { "$ref": "#/$defs/Identifier" },
        "causation_id": { "$ref": "#/$defs/Identifier" },
        "trace_id": { "$ref": "#/$defs/Identifier" },
        "source_system": { "$ref": "#/$defs/Identifier" },
        "source_event_id": { "$ref": "#/$defs/Identifier" },
        "source_resource_version": { "$ref": "#/$defs/Identifier" },
        "data_classification": { "$ref": "#/$defs/DataClassification" },
        "payload": {}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "event_type": { "const": "InterviewSessionEnded" },
                "payload": { "$ref": "#/$defs/InterviewSessionEndedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "CompletedInterviewImported" },
                "payload": { "$ref": "#/$defs/CompletedInterviewImportedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "RecordingAssetAvailable" },
                "payload": { "$ref": "#/$defs/RecordingAssetAvailablePayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "TranscriptReady" },
                "payload": { "$ref": "#/$defs/TranscriptReadyPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "TranscriptQualityRejected" },
                "payload": { "$ref": "#/$defs/TranscriptQualityRejectedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "EvaluationDraftGenerated" },
                "payload": { "$ref": "#/$defs/EvaluationDraftGeneratedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "EvaluationValidationFailed" },
                "payload": { "$ref": "#/$defs/EvaluationValidationFailedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "EvaluationPackageReadyForReview" },
                "payload": { "$ref": "#/$defs/EvaluationPackageReadyForReviewPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "EvaluationReviewSubmitted" },
                "payload": { "$ref": "#/$defs/EvaluationReviewSubmittedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "EvaluationConfirmed" },
                "payload": { "$ref": "#/$defs/EvaluationConfirmedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "RoundDecisionRecorded" },
                "payload": { "$ref": "#/$defs/RoundDecisionRecordedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "InterviewRoundCompleted" },
                "payload": { "$ref": "#/$defs/InterviewRoundCompletedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "AutomationActionRequested" },
                "payload": { "$ref": "#/$defs/AutomationActionRequestedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "AutomationActionSucceeded" },
                "payload": { "$ref": "#/$defs/AutomationActionSucceededPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "AutomationActionFailed" },
                "payload": { "$ref": "#/$defs/AutomationActionFailedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "AutomationActionCancelled" },
                "payload": { "$ref": "#/$defs/AutomationActionCancelledPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "ExternalActionSuppressed" },
                "payload": { "$ref": "#/$defs/ExternalActionSuppressedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "ExceptionBundleOpened" },
                "payload": { "$ref": "#/$defs/ExceptionBundleOpenedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "ExceptionBundleResolved" },
                "payload": { "$ref": "#/$defs/ExceptionBundleResolvedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "enum": ["CasePaused", "CaseResumed"] },
                "payload": { "$ref": "#/$defs/CaseControlPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "ParticipantConsentWithdrawn" },
                "payload": { "$ref": "#/$defs/ParticipantConsentWithdrawnPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "DataDeletionRequested" },
                "payload": { "$ref": "#/$defs/DataDeletionRequestedPayload" }
              }
            },
            {
              "properties": {
                "event_type": { "const": "DataDeletionCompleted" },
                "payload": { "$ref": "#/$defs/DataDeletionCompletedPayload" }
              }
            }
          ]
        }
      ]
    },
    "InterviewSessionEndedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interview_round_id", "interview_session_id", "ended_at", "outcome", "observed_start_missing", "participant_snapshot_ref"],
      "properties": {
        "interview_round_id": { "$ref": "#/$defs/Identifier" },
        "interview_session_id": { "$ref": "#/$defs/Identifier" },
        "ended_at": { "type": "string", "format": "date-time" },
        "outcome": { "type": "string", "enum": ["COMPLETED", "ABORTED", "UNKNOWN"] },
        "observed_start_missing": { "type": "boolean" },
        "participant_snapshot_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "CompletedInterviewImportedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interview_round_id", "interview_session_id", "from_round_state", "to_round_state", "scorecard_version", "source_artifact_sha256"],
      "properties": {
        "interview_round_id": { "$ref": "#/$defs/Identifier" },
        "interview_session_id": { "$ref": "#/$defs/Identifier" },
        "from_round_state": { "type": "string", "enum": ["PLANNED", "READY_TO_SCHEDULE"] },
        "to_round_state": { "const": "EVIDENCE_PROCESSING" },
        "scorecard_version": { "type": "integer", "minimum": 1 },
        "source_artifact_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "RecordingAssetAvailablePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interview_session_id", "artifact_id", "artifact_type", "artifact_version", "checksum", "consent_snapshot_ref", "retention_class"],
      "properties": {
        "interview_session_id": { "$ref": "#/$defs/Identifier" },
        "artifact_id": { "$ref": "#/$defs/Identifier" },
        "artifact_type": { "type": "string", "enum": ["RECORDING", "MANUAL_NOTES", "PROVIDER_TRANSCRIPT"] },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/Sha256" },
        "consent_snapshot_ref": { "$ref": "#/$defs/Reference" },
        "retention_class": { "$ref": "#/$defs/Identifier" }
      }
    },
    "TranscriptReadyPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript_id", "transcript_version", "artifact_id", "artifact_version", "language", "speaker_map_version", "segments_ref", "quality_manifest_ref"],
      "properties": {
        "transcript_id": { "$ref": "#/$defs/Identifier" },
        "transcript_version": { "type": "integer", "minimum": 1 },
        "artifact_id": { "$ref": "#/$defs/Identifier" },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "language": { "$ref": "#/$defs/Identifier" },
        "speaker_map_version": { "type": "integer", "minimum": 1 },
        "segments_ref": { "$ref": "#/$defs/Reference" },
        "quality_manifest_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "TranscriptQualityRejectedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "failure_codes", "affected_ranges_ref", "retryable"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/Identifier" },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "failure_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "affected_ranges_ref": { "$ref": "#/$defs/Reference" },
        "retryable": { "type": "boolean" }
      }
    },
    "EvaluationDraftGeneratedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "evaluation_version", "evidence_set_hash", "scorecard_version", "profile_version", "model_version", "prompt_version", "template_version", "claim_manifest_ref"],
      "properties": {
        "evaluation_id": { "$ref": "#/$defs/Identifier" },
        "evaluation_version": { "type": "integer", "minimum": 1 },
        "evidence_set_hash": { "$ref": "#/$defs/Sha256" },
        "scorecard_version": { "type": "integer", "minimum": 1 },
        "profile_version": { "type": "integer", "minimum": 1 },
        "model_version": { "$ref": "#/$defs/Identifier" },
        "prompt_version": { "$ref": "#/$defs/Identifier" },
        "template_version": { "$ref": "#/$defs/Identifier" },
        "claim_manifest_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "EvaluationValidationFailedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "evaluation_version", "failure_codes", "affected_claim_ids", "retryable", "validation_run_ref"],
      "properties": {
        "evaluation_id": { "$ref": "#/$defs/Identifier" },
        "evaluation_version": { "type": "integer", "minimum": 1 },
        "failure_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "affected_claim_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "retryable": { "type": "boolean" },
        "validation_run_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "EvaluationPackageReadyForReviewPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "evaluation_version", "evidence_coverage", "review_policy_ref", "confirmation_owner_id", "due_at"],
      "properties": {
        "evaluation_id": { "$ref": "#/$defs/Identifier" },
        "evaluation_version": { "type": "integer", "minimum": 1 },
        "evidence_coverage": { "const": 1 },
        "review_policy_ref": { "$ref": "#/$defs/Reference" },
        "confirmation_owner_id": { "$ref": "#/$defs/Identifier" },
        "due_at": { "type": "string", "format": "date-time" }
      }
    },
    "EvaluationReviewSubmittedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "reviewer_id", "evaluation_id", "evaluation_version", "disposition"],
      "properties": {
        "review_id": { "$ref": "#/$defs/Identifier" },
        "reviewer_id": { "$ref": "#/$defs/Identifier" },
        "evaluation_id": { "$ref": "#/$defs/Identifier" },
        "evaluation_version": { "type": "integer", "minimum": 1 },
        "disposition": { "type": "string", "enum": ["CONFIRM", "REQUEST_CHANGES", "REPORT_PROBLEM"] },
        "edit_diff_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "EvaluationConfirmedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "evaluation_version", "confirmation_ids", "review_policy_ref"],
      "properties": {
        "evaluation_id": { "$ref": "#/$defs/Identifier" },
        "evaluation_version": { "type": "integer", "minimum": 1 },
        "confirmation_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/Identifier" } },
        "review_policy_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "RoundDecisionRecordedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision_type", "human_actor_id", "evaluation_id", "evaluation_version", "decision_basis_ref"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/Identifier" },
        "decision_type": { "type": "string", "enum": ["ADVANCE_TO_NEXT", "REPEAT_ROUND", "STOP_PROCESS", "FINAL_ROUND_COMPLETE"] },
        "human_actor_id": { "$ref": "#/$defs/Identifier" },
        "evaluation_id": { "$ref": "#/$defs/Identifier" },
        "evaluation_version": { "type": "integer", "minimum": 1 },
        "decision_basis_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "InterviewRoundCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interview_round_id", "decision_id", "decision_type", "confirmed_evaluation_id", "confirmed_evaluation_version", "evidence_set_hash", "completed_at", "archive_manifest_ref"],
      "properties": {
        "interview_round_id": { "$ref": "#/$defs/Identifier" },
        "decision_id": { "$ref": "#/$defs/Identifier" },
        "decision_type": { "type": "string", "enum": ["ADVANCE_TO_NEXT", "REPEAT_ROUND", "STOP_PROCESS", "FINAL_ROUND_COMPLETE"] },
        "confirmed_evaluation_id": { "$ref": "#/$defs/Identifier" },
        "confirmed_evaluation_version": { "type": "integer", "minimum": 1 },
        "evidence_set_hash": { "$ref": "#/$defs/Sha256" },
        "completed_at": { "type": "string", "format": "date-time" },
        "archive_manifest_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "AutomationActionRequestedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "action_type", "target_ref", "business_revision", "payload_hash", "risk_class", "policy_snapshot_ref"],
      "properties": {
        "action_id": { "$ref": "#/$defs/Identifier" },
        "action_type": { "$ref": "#/$defs/Identifier" },
        "target_ref": { "$ref": "#/$defs/Reference" },
        "business_revision": { "$ref": "#/$defs/Identifier" },
        "payload_hash": { "$ref": "#/$defs/Sha256" },
        "risk_class": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "RED"] },
        "policy_snapshot_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "AutomationActionSucceededPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "attempt_no", "outcome", "connector_receipt_ref", "observed_at"],
      "properties": {
        "action_id": { "$ref": "#/$defs/Identifier" },
        "attempt_no": { "type": "integer", "minimum": 1 },
        "outcome": { "const": "SUCCEEDED" },
        "connector_receipt_ref": { "$ref": "#/$defs/Reference" },
        "external_resource_ref": { "$ref": "#/$defs/Reference" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "AutomationActionFailedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "attempt_no", "outcome", "error_code", "retryable", "observed_at"],
      "properties": {
        "action_id": { "$ref": "#/$defs/Identifier" },
        "attempt_no": { "type": "integer", "minimum": 1 },
        "outcome": { "const": "FAILED" },
        "error_code": { "$ref": "#/$defs/Identifier" },
        "retryable": { "type": "boolean" },
        "next_retry_at": { "type": "string", "format": "date-time" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "AutomationActionCancelledPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "attempt_no", "outcome", "error_code", "retryable", "cancellation_token", "observed_at"],
      "properties": {
        "action_id": { "$ref": "#/$defs/Identifier" },
        "attempt_no": { "type": "integer", "minimum": 1 },
        "outcome": { "const": "CANCELLED" },
        "error_code": { "$ref": "#/$defs/Identifier" },
        "retryable": { "const": false },
        "cancellation_token": { "$ref": "#/$defs/Identifier" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "ExternalActionSuppressedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "reason_code", "control_state_version", "suppressed_at"],
      "properties": {
        "action_id": { "$ref": "#/$defs/Identifier" },
        "reason_code": { "$ref": "#/$defs/Identifier" },
        "control_state_version": { "type": "integer", "minimum": 1 },
        "suppressed_at": { "type": "string", "format": "date-time" }
      }
    },
    "ExceptionBundleOpenedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception_id", "scope_ref", "code", "severity", "facts_ref", "options_ref", "owner_ref", "due_at", "resume_token_ref"],
      "properties": {
        "exception_id": { "$ref": "#/$defs/Identifier" },
        "scope_ref": { "$ref": "#/$defs/Reference" },
        "code": { "$ref": "#/$defs/Identifier" },
        "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "facts_ref": { "$ref": "#/$defs/Reference" },
        "options_ref": { "$ref": "#/$defs/Reference" },
        "owner_ref": { "$ref": "#/$defs/Reference" },
        "due_at": { "type": "string", "format": "date-time" },
        "resume_token_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "ExceptionBundleResolvedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception_id", "resolution_id", "selected_option", "resolver_id", "resume_token_ref", "resolved_at"],
      "properties": {
        "exception_id": { "$ref": "#/$defs/Identifier" },
        "resolution_id": { "$ref": "#/$defs/Identifier" },
        "selected_option": { "$ref": "#/$defs/Identifier" },
        "resolver_id": { "$ref": "#/$defs/Identifier" },
        "resume_token_ref": { "$ref": "#/$defs/Reference" },
        "resolved_at": { "type": "string", "format": "date-time" }
      }
    },
    "CaseControlPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_type", "scope_id", "reason_code", "control_token", "effective_at"],
      "properties": {
        "scope_type": { "type": "string", "enum": ["TENANT", "REQUISITION", "APPLICATION_CASE"] },
        "scope_id": { "$ref": "#/$defs/Identifier" },
        "reason_code": { "$ref": "#/$defs/Identifier" },
        "control_token": { "$ref": "#/$defs/Identifier" },
        "effective_at": { "type": "string", "format": "date-time" }
      }
    },
    "ParticipantConsentWithdrawnPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_id", "purposes", "effective_at", "receipt_ref"],
      "properties": {
        "participant_id": { "$ref": "#/$defs/Identifier" },
        "purposes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["RECORDING", "TRANSCRIPTION", "EVALUATION_SUPPORT"] } },
        "effective_at": { "type": "string", "format": "date-time" },
        "receipt_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "DataDeletionRequestedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_request_id", "subject_ref", "scope_manifest_ref", "lineage_run_ref", "requested_at"],
      "properties": {
        "privacy_request_id": { "$ref": "#/$defs/Identifier" },
        "subject_ref": { "$ref": "#/$defs/Reference" },
        "scope_manifest_ref": { "$ref": "#/$defs/Reference" },
        "lineage_run_ref": { "$ref": "#/$defs/Reference" },
        "requested_at": { "type": "string", "format": "date-time" }
      }
    },
    "DataDeletionCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_request_id", "lineage_run_ref", "completion_receipt_ref", "completed_at"],
      "properties": {
        "privacy_request_id": { "$ref": "#/$defs/Identifier" },
        "lineage_run_ref": { "$ref": "#/$defs/Reference" },
        "completion_receipt_ref": { "$ref": "#/$defs/Reference" },
        "retained_item_manifest_ref": { "$ref": "#/$defs/Reference" },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "ActionAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_no", "started_at", "outcome"],
      "properties": {
        "attempt_no": { "type": "integer", "minimum": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "outcome": { "type": "string", "enum": ["IN_FLIGHT", "SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN_RECONCILE"] },
        "connector_receipt_ref": { "$ref": "#/$defs/Reference" },
        "error_code": { "$ref": "#/$defs/Identifier" },
        "retryable": { "type": "boolean" }
      }
    },
    "ActionExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "tenant_id",
        "application_case_id",
        "lifecycle_epoch",
        "action_id",
        "action_type",
        "state",
        "idempotency_key",
        "business_revision",
        "payload_ref",
        "payload_hash",
        "policy_snapshot_ref",
        "attempts",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "ActionExecution" },
        "tenant_id": { "$ref": "#/$defs/Identifier" },
        "application_case_id": { "$ref": "#/$defs/Identifier" },
        "lifecycle_epoch": { "type": "integer", "minimum": 1 },
        "action_id": { "$ref": "#/$defs/Identifier" },
        "action_type": { "$ref": "#/$defs/Identifier" },
        "state": { "type": "string", "enum": ["REQUESTED", "AUTHORIZED", "IN_FLIGHT", "SUCCEEDED", "FAILED", "CANCELLED", "SUPPRESSED", "NEEDS_RECONCILIATION"] },
        "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 256 },
        "business_revision": { "$ref": "#/$defs/Identifier" },
        "payload_ref": { "$ref": "#/$defs/Reference" },
        "payload_hash": { "$ref": "#/$defs/Sha256" },
        "policy_snapshot_ref": { "$ref": "#/$defs/Reference" },
        "cancellation_token": { "$ref": "#/$defs/Identifier" },
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/ActionAttempt" } },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "ExceptionFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "fact_ref"],
      "properties": {
        "code": { "$ref": "#/$defs/Identifier" },
        "fact_ref": { "$ref": "#/$defs/Reference" }
      }
    },
    "ResolutionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "label_key", "command_type", "requires_human"],
      "properties": {
        "option_id": { "$ref": "#/$defs/Identifier" },
        "label_key": { "$ref": "#/$defs/Identifier" },
        "command_type": { "$ref": "#/$defs/Identifier" },
        "requires_human": { "type": "boolean" }
      }
    },
    "ExceptionBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "tenant_id",
        "application_case_id",
        "lifecycle_epoch",
        "exception_id",
        "scope_ref",
        "causal_resource_version",
        "code",
        "severity",
        "status",
        "facts",
        "risk_summary_ref",
        "attempted_action_refs",
        "options",
        "recommended_option_id",
        "owner_ref",
        "due_at",
        "resume_token_ref",
        "opened_at"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "record_type": { "const": "ExceptionBundle" },
        "tenant_id": { "$ref": "#/$defs/Identifier" },
        "application_case_id": { "$ref": "#/$defs/Identifier" },
        "lifecycle_epoch": { "type": "integer", "minimum": 1 },
        "exception_id": { "$ref": "#/$defs/Identifier" },
        "scope_ref": { "$ref": "#/$defs/Reference" },
        "causal_resource_version": { "$ref": "#/$defs/Identifier" },
        "code": { "$ref": "#/$defs/Identifier" },
        "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "type": "string", "enum": ["OPEN", "RESOLVED", "SUPERSEDED"] },
        "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ExceptionFact" } },
        "risk_summary_ref": { "$ref": "#/$defs/Reference" },
        "attempted_action_refs": { "type": "array", "items": { "$ref": "#/$defs/Reference" } },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ResolutionOption" } },
        "recommended_option_id": { "$ref": "#/$defs/Identifier" },
        "owner_ref": { "$ref": "#/$defs/Reference" },
        "due_at": { "type": "string", "format": "date-time" },
        "resume_token_ref": { "$ref": "#/$defs/Reference" },
        "opened_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
